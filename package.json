{
  "name": "qkrbiz-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node server/server.js",
    "build:client": "vite build --outDir dist/client --ssrManifest",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir dist/server",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=2048 npm run build:client && npm run build:server",
    "serve": "cross-env NODE_ENV=production node server/server.js",
    "start": "cross-env NODE_ENV=production node server/server.js"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^1.16.8",
    "@unhead/react": "^3.2.3",
    "@unhead/ssr": "^3.2.3",
    "axios": "^1.19.0",
    "bootstrap": "^5.3.6",
    "compression": "^1.8.1",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "html-truncate": "^1.2.2",
    "html2canvas": "^1.4.1",
    "isomorphic-dompurify": "^3.19.0",
    "jspdf": "^4.2.1",
    "keen-slider": "^6.8.6",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-icons": "^5.7.0",
    "react-insta-stories": "^2.8.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.102.0",
    "vite": "^7.3.6"
  }
}
